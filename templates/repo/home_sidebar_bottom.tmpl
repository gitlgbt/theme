<div class="repo-home-sidebar-bottom flex-relaxed-list">

	{{if and .LatestRelease (.Permission.CanRead $.UnitTypeReleases)}}
		<div class="divider"></div>
		<div class="repo-home-sidebar-header">
			<a class="item muted" href="{{.RepoLink}}/releases">{{ctx.Locale.Tr "repo.releases"}}</a>
			<span class="ui small label">{{ctx.Locale.PrettyNumber .NumReleases}}</span>
		</div>
		<div>
			<div class="flex-text-block">
				<div>{{svg "octicon-tag"}}</div>
				<a class="gt-ellipsis muted" href="{{.RepoLink}}/releases/tag/{{PathEscapeSegments .LatestRelease.TagName}}" title="{{if .LatestRelease.Title}}{{.LatestRelease.Title}}{{else}}{{.LatestRelease.TagName}}{{end}}"><strong>{{if .LatestRelease.Title}}{{.LatestRelease.Title}}{{else}}{{.LatestRelease.TagName}}{{end}}</strong></a>
				<div class="tw-shrink-0">
					{{if .LatestRelease.IsPrerelease}}
						<span class="ui small basic label">{{ctx.Locale.Tr "repo.release.prerelease"}}</span>
					{{else if .LatestReleaseIsLatest}}
						<span class="ui small basic label">{{ctx.Locale.Tr "repo.sidebar.release_latest"}}</span>
					{{end}}
				</div>
			</div>
			<div class="tw-ml-[24px] tw-text-12">{{DateUtils.TimeSince .LatestRelease.CreatedUnix}}</div>
		</div>
	{{end}}

	{{if and .SidebarPackages (.Permission.CanRead $.UnitTypePackages)}}
		<div class="divider"></div>
		<div class="repo-home-sidebar-header">
			<a class="item muted" href="{{.RepoLink}}/packages">{{ctx.Locale.Tr "packages.title"}}</a>
			<span class="ui small label">{{ctx.Locale.PrettyNumber .SidebarPackagesTotal}}</span>
		</div>
		<div class="flex-relaxed-list">
			{{range .SidebarPackages}}
				<div class="flex-text-block">
					<a class="gt-ellipsis muted" href="{{.Link}}" title="{{.Name}} {{.Version}}"><strong>{{.Name}}</strong></a>
					<span class="text light-2 tw-text-12 tw-shrink-0">{{.Type}} {{.Version}}</span>
				</div>
			{{end}}
		</div>
		{{if gt .SidebarPackagesMore 0}}
			<a class="muted" href="{{.RepoLink}}/packages">{{ctx.Locale.Tr "repo.sidebar.packages_more" (ctx.Locale.PrettyNumber .SidebarPackagesMore)}}</a>
		{{end}}
	{{end}}

	{{if and (not .IsEmptyRepo) (.Permission.CanRead $.UnitTypeCode)}}
		{{if .SidebarContributors}}
			<div class="divider"></div>
			<div class="repo-home-sidebar-header">
				<a class="item muted" href="{{.RepoLink}}/activity/contributors">{{ctx.Locale.Tr "repo.sidebar.contributors"}}</a>
				<span class="ui small label">{{ctx.Locale.PrettyNumber .SidebarContributorsTotal}}</span>
			</div>
			<div class="repo-contributors-avatars">
				{{range .SidebarContributors}}
					{{$label := .Name}}{{if not $label}}{{$label = .Login}}{{end}}
					{{if .HomeLink}}
						<a href="{{.HomeLink}}" title="{{$label}}"><img class="ui avatar" src="{{.AvatarLink}}" width="32" height="32" loading="lazy" alt="{{$label}}"></a>
					{{else}}
						<span title="{{$label}}"><img class="ui avatar" src="{{.AvatarLink}}" width="32" height="32" loading="lazy" alt="{{$label}}"></span>
					{{end}}
				{{end}}
			</div>
			{{if gt .SidebarContributorsMore 0}}
				<a class="muted" href="{{.RepoLink}}/activity/contributors">{{ctx.Locale.Tr "repo.sidebar.contributors_more" (ctx.Locale.PrettyNumber .SidebarContributorsMore)}}</a>
			{{end}}
		{{else if .SidebarContributorsPending}}
			<div class="divider"></div>
			<div class="repo-home-sidebar-header">
				<a class="item muted" href="{{.RepoLink}}/activity/contributors">{{ctx.Locale.Tr "repo.sidebar.contributors"}}</a>
			</div>
			<div class="text light-2 tw-text-12">{{ctx.Locale.Tr "repo.sidebar.contributors_pending"}}</div>
		{{end}}
	{{end}}

	{{if and (not .IsEmptyRepo) .LanguageStats}}
		<div class="divider"></div>
		<div class="repo-home-sidebar-header">
			{{ctx.Locale.Tr "repo.sidebar.languages"}}
		</div>

		<div>
			<div class="language-stats">
				{{range .LanguageStats}}
				<div class="bar" style="width: {{.Percentage}}%; background-color: {{.Color}}" data-tooltip-placement="top" data-tooltip-content="{{.Language}}" data-tooltip-follow-cursor="horizontal"></div>
				{{end}}
			</div>
			<div class="language-stats-details">
				{{range .LanguageStats}}
				<div class="item">
					<i class="color-icon" style="background-color: {{.Color}}"></i>
					<strong class="tw-font-semibold">
						{{if eq .Language "other"}}{{ctx.Locale.Tr "repo.language_other"}}{{else}}{{.Language}}{{end}}
					</strong>
					{{.Percentage}}%
				</div>
				{{end}}
			</div>
		</div>
	{{end}}
</div>
